#!/bin/zsh
# Shows the setup QR code for Hermes Bot: your Hermes API URL on the tailnet
# plus your Hermes API_SERVER_KEY. Open Hermes Bot on the glasses (it opens
# the scanner the first time, or say "scan"), look at the code, tap.
#
#   hermes-bot-qr              QR in a Preview window (easiest for the camera)
#   hermes-bot-qr --terminal   QR printed in this terminal
#
# Settings (environment variables):
#   HERMES_HOME         Hermes home folder, where .env holds the key (default ~/.hermes)
#   HERMES_BOT_PORT     tailnet port Hermes is served on (default 8461)
#   HERMES_BOT_URL      full URL; overrides the port and tailnet name
#
# The QR holds the key: anyone who can photograph it can use your Hermes
# agent. Show it only to your glasses, and close the window afterwards.
set -euo pipefail

hermes_home=${HERMES_HOME:-$HOME/.hermes}
port=${HERMES_BOT_PORT:-8461}

if [[ -z ${HERMES_BOT_URL:-} ]]; then
  # The Mac's tailnet name. The Hi Rokid app reaches it by name; a bare
  # tailnet IP did not work in testing. If Tailscale renames the Mac, run
  # this again and rescan.
  command -v tailscale >/dev/null || { print -u2 "The tailscale command isn't installed. In the Tailscale app: Settings > Install CLI (see the README)."; exit 1; }
  host=$(tailscale status --json 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin)["Self"]["DNSName"].rstrip("."))' 2>/dev/null || true)
  [[ -n $host ]] || { print -u2 "Tailscale isn't connected on this Mac, or MagicDNS is off (the QR uses the Mac's tailnet name)."; exit 1; }
  HERMES_BOT_URL="http://$host:$port"
fi

key=$(grep -E '^API_SERVER_KEY=' "$hermes_home/.env" 2>/dev/null | tail -1 | cut -d= -f2- || true)
# Allow API_SERVER_KEY="..." or '...' in .env.
key=${key#[\"\']}; key=${key%[\"\']}
[[ -n $key ]] || { print -u2 "No API_SERVER_KEY in $hermes_home/.env (see the README: Hermes API server)."; exit 1; }
command -v qrencode >/dev/null || { print -u2 "Needs qrencode: brew install qrencode"; exit 1; }

payload=$(python3 -c 'import json,sys; print(json.dumps({"hermes": sys.argv[1], "key": sys.argv[2]}))' "$HERMES_BOT_URL" "$key")

if [[ ${1:-} == --terminal ]]; then
  qrencode -t ANSIUTF8 -m 2 "$payload"
  exit 0
fi

# Preview keeps showing the image after the temporary file is deleted.
png=$(mktemp -t hermes-bot-qr).png
qrencode -o "$png" -s 16 -m 4 "$payload"
open -a Preview "$png"
sleep 3
rm -f "$png" "${png%.png}"
print "QR shown in Preview for $HERMES_BOT_URL. Close the window when done."
